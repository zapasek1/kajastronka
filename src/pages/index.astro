---
import Base from '../layouts/Base.astro';
import settings from '../content/settings.json';
import galleries from '../content/galleries.json';
import contact from '../content/contact.json';
import { asset } from '../lib/util';

type Item = { image?: string; title?: string; description?: string };
type Section = { id: string; label: string; intro?: string; offer?: string; items?: Item[] };
type Feature = { image: string; section: string };

const sections = (galleries.sections as Section[]).filter((s) => s.id && s.label);
const tabs = [...sections.map((s) => ({ id: s.id, label: s.label })), { id: 'contact', label: 'contact' }];
const labelOf = (id: string) => tabs.find((t) => t.id === id)?.label ?? id;
const home = ((galleries.home ?? []) as Feature[]).filter((f) => f.image).slice(0, 4);
const year = new Date().getFullYear();
const mail = `mailto:${settings.email}`;
---
<Base>
  <header class="top wrap">
    <div class="top__bar">
      <a class="brand" href="#home" data-tab-link="home">{settings.name}</a>
      <nav class="social" aria-label="Contact links">
        {settings.email && (
          <a class="glass social__btn" href={mail} aria-label="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
          </a>
        )}
        {settings.instagram_url && (
          <a class="glass social__btn" href={settings.instagram_url} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.7" class="fill" /></svg>
          </a>
        )}
      </nav>
    </div>
  </header>

  <div class="tabs-wrap wrap">
    <div class="tabs glass" role="tablist" aria-label="Portfolio sections">
      <span class="tabs__indicator" aria-hidden="true"></span>
      {tabs.map((t) => (
        <a class="tab" role="tab" id={`tab-${t.id}`} href={`#${t.id}`} aria-controls={t.id} aria-selected="false">{t.label}</a>
      ))}
    </div>
  </div>

  <main id="content" class="wrap">
    <section id="home" class="panel panel--home" data-panel>
      <div class="hero">
        <p class="hero__tagline">{settings.tagline}</p>
        {settings.intro && <p class="hero__intro">{settings.intro}</p>}
      </div>
      <ul class="home-grid">
        {home.map((f, i) => (
          <li class="tile glass" style={`--i:${i}`}>
            <a class="tile__link" href={`#${f.section}`} data-tab-link={f.section}>
              <img src={asset(f.image)} alt="" width="1000" height="1000" loading="eager" decoding="async" />
              <span class="tile__label">{labelOf(f.section)} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {sections.map((s) => (
      <section id={s.id} class="panel" role="tabpanel" aria-labelledby={`tab-${s.id}`} data-panel>
        {(s.intro || s.offer) && (
          <div class="panel__head">
            {s.intro && <p class="panel__intro">{s.intro}</p>}
            {s.offer && <p class="panel__offer glass">{s.offer}</p>}
          </div>
        )}
        <ul class="grid">
          {(s.items ?? []).filter((it) => it.image || it.title || it.description).map((it, i) => (
            it.image ? (
              <li class="tile glass" style={`--i:${i}`}>
                <button type="button" class="tile__btn" data-full={asset(it.image)} data-title={it.title ?? ''} data-desc={it.description ?? ''} aria-label={`Open ${it.title || 'image'}`}>
                  <img src={asset(it.image)} alt={it.title ?? ''} width="1000" height="1000" loading="lazy" decoding="async" />
                  {(it.title || it.description) && (
                    <span class="tile__caption">
                      {it.title && <span class="tile__title">{it.title}</span>}
                      {it.description && <span class="tile__desc">{it.description}</span>}
                    </span>
                  )}
                </button>
              </li>
            ) : (
              <li class="tile tile--text glass" style={`--i:${i}`}>
                <div class="tile__text">
                  {it.title && <h2>{it.title}</h2>}
                  {it.description && <p>{it.description}</p>}
                </div>
              </li>
            )
          ))}
        </ul>
      </section>
    ))}

    <section id="contact" class="panel" role="tabpanel" aria-labelledby="tab-contact" data-panel>
      <div class="contact glass">
        <div class="contact__text">
          <h2 class="contact__heading">{contact.heading}</h2>
          <p>{contact.text}</p>
          {contact.services?.length > 0 && (
            <ul class="contact__services">
              {contact.services.map((x: string) => <li>{x}</li>)}
            </ul>
          )}
          {contact.location && <p class="contact__loc">{contact.location}</p>}
        </div>
        <div class="contact__links">
          {settings.email && (
            <a class="glass contact__link" href={mail}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
              <span>{settings.email}</span>
            </a>
          )}
          {settings.instagram_url && (
            <a class="glass contact__link" href={settings.instagram_url} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.7" class="fill" /></svg>
              <span>Instagram</span>
            </a>
          )}
        </div>
      </div>
    </section>
  </main>

  <footer class="foot wrap">© {year} {settings.name}</footer>

  <dialog class="lightbox" aria-label="Image preview">
    <div class="lightbox__inner glass">
      <button type="button" class="lightbox__close" aria-label="Close">×</button>
      <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Previous">‹</button>
      <figure>
        <img alt="" />
        <figcaption><strong></strong><span></span></figcaption>
      </figure>
      <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Next">›</button>
    </div>
  </dialog>

  <script>
    import { initTabs } from '../scripts/tabs';
    import { initLightbox } from '../scripts/lightbox';
    import { initSheen } from '../scripts/sheen';
    initTabs();
    initLightbox();
    initSheen();
  </script>
</Base>
